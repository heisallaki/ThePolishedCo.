---
interface Props {
  platform: "instagram" | "tiktok" | "whatsapp";
  size?: number;
}

const { platform, size = 20 } = Astro.props;
---

{platform === "instagram" && (
  <svg
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="3" y="3" width="18" height="18" rx="5.5"></rect>
    <circle cx="12" cy="12" r="4.2"></circle>
    <circle cx="17.3" cy="6.7" r="0.65" fill="currentColor" stroke="none"></circle>
  </svg>
)}
{platform === "tiktok" && (
  <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M16.5 3c.3 2.1 1.7 3.7 3.8 4.1v3.1c-1.4-.1-2.7-.5-3.8-1.3v6.4a5.7 5.7 0 1 1-5.7-5.7c.3 0 .6 0 .9.1v3.1a2.6 2.6 0 1 0 1.8 2.5V3h3z"></path>
  </svg>
)}
{platform === "whatsapp" && (
  <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M12 2C6.5 2 2 6.3 2 11.6c0 1.8.5 3.6 1.5 5.1L2 22l5.5-1.4c1.4.7 3 1.1 4.5 1.1 5.5 0 10-4.3 10-9.6C22 6.3 17.5 2 12 2zm5.6 13.6c-.2.6-1.3 1.2-1.8 1.3-.5.1-1 .1-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 1-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5-.1.2-.3.4-.4.5-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.7.8.2.1.4.2.5.3.1.2.1.9-.1 1.5z"></path>
  </svg>
)}