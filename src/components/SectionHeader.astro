---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  level?: "h1" | "h2";
}

const { eyebrow, title, description, align = "center", level = "h2" } = Astro.props;
const Tag = level;
---

<div class={`section-header section-header-${align}`}>
  {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
  <Tag class="section-title">{title}</Tag>
  {description && <p class="section-description">{description}</p>}
</div>

<style>
  .section-header {
    max-width: 640px;
    margin-bottom: var(--space-lg);
  }

  .section-header-center {
    margin-inline: auto;
    text-align: center;
  }

  .section-eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-rose-600);
    margin-bottom: var(--space-2xs);
  }

  .section-title {
    font-family: var(--font-display);
    color: var(--color-rose-900);
    line-height: 1.15;
    margin: 0 0 var(--space-sm);
    font-weight: 600;
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.75rem);
  }

  .section-description {
    color: var(--color-ink-500);
  }
</style>