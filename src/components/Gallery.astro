---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  videos: string[];
  collectionName: string;
}

const { images, videos, collectionName } = Astro.props;
const isEmpty = images.length === 0 && videos.length === 0;
---

<div class="gallery-root" data-gallery-root>
  {isEmpty ? (
    <div class="gallery-empty glass-surface">
      <p>We're adding real client photos and videos from {collectionName} here soon.</p>
    </div>
  ) : (
    <div class="gallery">
      {images.map((image, index) => (
        <button
          type="button"
          class="gallery-item"
          data-lightbox-trigger
          aria-label={`View photo ${index + 1} from ${collectionName}`}
        >
          <Image
            src={image}
            alt={`${collectionName} work, photo ${index + 1}`}
            width={480}
            densities={[1, 2]}
            loading="lazy"
          />
        </button>
      ))}
      {videos.map((video) => (
        <div class="gallery-item gallery-video">
          <video controls preload="metadata" playsinline src={video}>
            Your browser does not support the video tag.
          </video>
        </div>
      ))}
    </div>
  )}

  {images.length > 0 && (
    <dialog class="lightbox" data-lightbox aria-label="Image preview">
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">&times;</button>
      <img class="lightbox-image" data-lightbox-image alt="" />
    </dialog>
  )}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-sm);
  }

  .gallery-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-glass-soft);
    background: var(--surface-glass);
    padding: 0;
    cursor: pointer;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .gallery-item:hover :global(img) {
    transform: scale(1.04);
  }

  .gallery-video {
    cursor: default;
  }

  .gallery-video video {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-md);
  }

  .gallery-empty {
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    text-align: center;
    color: var(--color-ink-500);
  }

  .lightbox {
    border: none;
    border-radius: var(--radius-lg);
    padding: var(--space-sm);
    max-width: min(90vw, 900px);
    max-height: 90vh;
    background: var(--color-white);
    box-shadow: var(--shadow-lift);
  }

  .lightbox::backdrop {
    background: rgba(43, 20, 32, 0.72);
    backdrop-filter: blur(4px);
  }

  .lightbox-close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: var(--surface-glass-strong);
    color: var(--color-rose-900);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    z-index: 1;
  }

  .lightbox-image {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    margin-inline: auto;
    border-radius: var(--radius-md);
  }
</style>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-gallery-root]");

  roots.forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>("[data-lightbox]");
    const lightboxImage = root.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const triggers = root.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]");

    if (!dialog || !lightboxImage) {
      return;
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const img = trigger.querySelector("img");
        if (img instanceof HTMLImageElement) {
          lightboxImage.src = img.src;
          lightboxImage.alt = img.alt;
        }
        dialog.showModal();
      });
    });

    const closeButton = dialog.querySelector("[data-lightbox-close]");
    closeButton?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  });
</script>