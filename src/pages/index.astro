---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import GlassCard from "../components/GlassCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { business } from "../config/business";
---

<BaseLayout
  title="Home"
  description="The Polished Co. Ke is a premium beauty destination in Juja, Kenya, offering nails, lashes, and more."
>
  <section class="hero section">
    <div class="container hero-inner">
      <p class="hero-eyebrow">{business.location.display}</p>
      <h1>{business.tagline}</h1>
      <p class="hero-copy">
        {business.name} is a premium beauty destination in Juja, bringing nails, lashes, and more
        together under one polished, pink-and-gold glass roof.
      </p>
      <div class="hero-actions">
        <Button href="/book" variant="primary" size="lg">Book Appointment</Button>
        <Button href="/services" variant="secondary" size="lg">Explore Services</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="The Experience"
        title="Why The Polished Co."
        description="A calm, glass-pink space in Juja where every detail is considered, from the first message to the final polish."
      />
      <div class="value-grid">
        <GlassCard hover>
          <h3>Personal, unhurried care</h3>
          <p>Every appointment is treated as its own occasion, not a rushed slot on a schedule.</p>
        </GlassCard>
        <GlassCard hover>
          <h3>One home for beauty</h3>
          <p>Nails today, lashes next week — one trusted studio for every part of your look.</p>
        </GlassCard>
        <GlassCard hover>
          <h3>Booking made simple</h3>
          <p>Reach out on WhatsApp, Instagram, or TikTok and Jael will take it from there.</p>
        </GlassCard>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-wrap">
        <GlassCard padding="lg">
          <h2>Ready to feel polished?</h2>
          <p>Tell us what you have in mind and we will help you pick the perfect service.</p>
          <Button href="/book" variant="primary" size="lg">Book Your Appointment</Button>
        </GlassCard>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-inner {
    max-width: 760px;
    text-align: center;
    margin-inline: auto;
  }

  .hero-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-rose-600);
    margin-bottom: var(--space-sm);
  }

  .hero-copy {
    font-size: 1.1rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-top: var(--space-lg);
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 768px) {
    .value-grid {
      grid-template-columns: 1fr;
    }
  }

  .cta-wrap {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .cta-wrap h2 {
    margin-bottom: var(--space-2xs);
  }

  .cta-wrap p {
    margin-bottom: var(--space-md);
  }
</style>