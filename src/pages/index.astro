---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import GlassCard from "../components/GlassCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CollectionCard from "../components/CollectionCard.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { business } from "../config/business";
import { collections } from "../data/collections";
import { getReviews } from "../utils/reviews";

const reviews = await getReviews();
---

<BaseLayout
  title="Home"
  description="The Polished Co. Ke is a premium beauty destination in Juja, Kenya, offering nails, lashes, and more."
>
  <section class="hero section">
    <div class="container hero-inner">
      <p class="hero-eyebrow">{business.location.display}</p>
      <h1>{business.tagline}</h1>
      <p class="hero-copy">
        {business.name} is a beauty destination in Juja, bringing nails, lashes, makeup, wigs, waxing, massage, and 
        beauty essentials together in one beautiful space.
      </p>
      <div class="hero-actions">
        <Button href="/book" variant="primary" size="lg">Book Appointment</Button>
        <Button href="/services" variant="secondary" size="lg">Explore Services</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Our Collections"
        title="Seven Ways To Feel Polished"
        description="From nails and lashes to makeup, wigs, waxing, massage, and beauty retail. Every collection lives under one roof in Juja."
      />
      <div class="collections-grid">
        {collections.map((collection) => (
          <CollectionCard collection={collection} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="The Experience"
        title="Why The Polished Co."
        description="A chill beauty spot in Juja where you feel good, look good, and leave polished."
      />
      <div class="value-grid">
        <GlassCard hover>
          <h3>Personal, unhurried care</h3>
          <p>Every appointment is treated as its own occasion, not a rushed slot on a schedule.</p>
        </GlassCard>
        <GlassCard hover>
          <h3>One home for beauty</h3>
          <p>Nails today, lashes next week — one trusted studio for every part of your look.</p>
        </GlassCard>
        <GlassCard hover>
          <h3>Booking made simple</h3>
          <p>Reach out on WhatsApp, Instagram, or TikTok and Jael will take it from there.</p>
        </GlassCard>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Client Reviews"
        title="What Clients Are Saying"
        description="Feedback from our clients."
      />
      {reviews.length > 0 ? (
        <div class="home-reviews-grid">
          {reviews.slice(0, 3).map((review) => (
            <ReviewCard review={review} />
          ))}
        </div>
      ) : (
        <div class="home-reviews-empty">
          <GlassCard padding="lg">
            <h3>Your experience matters</h3>
            <p>Be one of the first clients to share your experience with The Polished Co. Ke.</p>
            <Button href="/reviews" variant="primary">See Reviews</Button>
          </GlassCard>
        </div>
      )}
      {reviews.length > 0 && (
        <div class="home-reviews-cta">
          <Button href="/reviews" variant="secondary">See All Reviews</Button>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-wrap">
        <GlassCard padding="lg">
          <h2>Ready to feel polished?</h2>
          <p>Tell us what you have in mind and we will help you pick the perfect service.</p>
          <Button href="/book" variant="primary" size="lg">Book Your Appointment</Button>
        </GlassCard>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-inner {
    max-width: 760px;
    text-align: center;
    margin-inline: auto;
  }

  .hero-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-rose-600);
    margin-bottom: var(--space-sm);
  }

  .hero-copy {
    font-size: 1.1rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-top: var(--space-lg);
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 768px) {
    .value-grid {
      grid-template-columns: 1fr;
    }
  }

  .home-reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 1024px) {
    .home-reviews-grid {
      grid-template-columns: 1fr;
    }
  }

  .home-reviews-empty {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .home-reviews-empty p {
    margin-bottom: var(--space-md);
  }

  .home-reviews-cta {
    margin-top: var(--space-lg);
    text-align: center;
  }

  .cta-wrap {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .cta-wrap h2 {
    margin-bottom: var(--space-2xs);
  }

  .cta-wrap p {
    margin-bottom: var(--space-md);
  }
</style>