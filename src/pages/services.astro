---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CollectionCard from "../components/CollectionCard.astro";
import { collections } from "../data/collections";
---

<BaseLayout
  title="Beauty Services in Juja"
  description="Explore nail services, lash services, makeup, wig installation, waxing, massage, and beauty products in Juja, Kenya — seven collections at The Polished Co."
>
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Our Collections"
        title="Seven Ways To Feel Polished"
        description="From nails and lashes to makeup, wigs, waxing, massage, and beauty retail — every collection lives under one roof in Juja."
        level="h1"
      />
      <div class="collections-grid">
        {collections.map((collection) => (
          <CollectionCard collection={collection} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>