---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import GlassCard from "../components/GlassCard.astro";
import { routes } from "../utils/url";
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist on The Polished Co. Ke."
  noindex
>
  <section class="section not-found">
    <div class="container not-found-inner">
      <GlassCard padding="lg">
        <p class="not-found-eyebrow">404</p>
        <h1>This page didn't make the cut</h1>
        <p>
          The page you're looking for may have moved, been renamed, or never existed. Let's get you
          back to something polished.
        </p>
        <div class="not-found-actions">
          <Button href={routes.home} variant="primary" size="lg">Back to Home</Button>
          <Button href={routes.services} variant="secondary" size="lg">Explore Services</Button>
        </div>
      </GlassCard>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: 60vh;
  }

  .not-found-inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .not-found-eyebrow {
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-pink-300);
    margin-bottom: var(--space-2xs);
    line-height: 1;
  }

  .not-found h1 {
    margin-bottom: var(--space-sm);
  }

  .not-found p {
    margin-bottom: var(--space-md);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-top: var(--space-md);
  }
</style>