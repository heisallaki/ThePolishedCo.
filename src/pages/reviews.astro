---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import GlassCard from "../components/GlassCard.astro";
import Button from "../components/Button.astro";
import ReviewCard from "../components/ReviewCard.astro";
import RatingStars from "../components/RatingStars.astro";
import { getReviews } from "../utils/reviews";
import { buildWhatsAppLink } from "../utils/whatsapp";

const reviews = await getReviews();
const averageRating =
  reviews.length > 0 ? reviews.reduce((total, review) => total + review.rating, 0) / reviews.length : 0;
const reviewFormUrl =
  import.meta.env.REVIEW_FORM_URL ||
  buildWhatsAppLink("Hi Jael, I'd like to leave a review of my experience with The Polished Co.");
---

<BaseLayout title="Client Reviews" description="Client reviews for The Polished Co. Ke in Juja, Kenya.">
  <section class="section">
    <div class="container">
      {reviews.length > 0 ? (
        <div class="reviews-content">
          <SectionHeader eyebrow="Client Reviews" title="What Clients Are Saying" align="left" level="h1" />
          <div class="reviews-summary">
            <RatingStars rating={averageRating} />
            <span>
              {averageRating.toFixed(1)} out of 5 · {reviews.length} review{reviews.length === 1 ? "" : "s"}
            </span>
          </div>
          <div class="reviews-grid">
            {reviews.map((review) => (
              <ReviewCard review={review} />
            ))}
          </div>
          <div class="reviews-cta">
            <Button href={reviewFormUrl} variant="secondary" target="_blank">
              Leave a Review
            </Button>
          </div>
        </div>
      ) : (
        <div class="reviews-empty">
          <GlassCard padding="lg">
            <h1 class="reviews-empty-title">Your experience matters</h1>
            <p>Be one of the first clients to share your experience with The Polished Co. Ke.</p>
            <Button href={reviewFormUrl} variant="primary" target="_blank">
              Leave a Review
            </Button>
          </GlassCard>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .reviews-summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    color: var(--color-ink-700);
    font-weight: 600;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .reviews-cta {
    margin-top: var(--space-lg);
    text-align: center;
  }

  .reviews-empty {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .reviews-empty-title {
    font-family: var(--font-display);
    color: var(--color-rose-900);
    font-weight: 600;
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.75rem);
    line-height: 1.15;
    margin: 0 0 var(--space-sm);
  }

  .reviews-empty p {
    margin-bottom: var(--space-md);
  }
</style>