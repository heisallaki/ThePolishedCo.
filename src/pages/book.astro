---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import GlassCard from "../components/GlassCard.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="Book" description="Book an appointment with The Polished Co. Ke in Juja, Kenya.">
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Coming Soon"
        title="Book an Appointment"
        description="Soon you'll be able to pick a service, choose a time, and send your request straight to Jael from this page."
      />
      <div class="stub-wrap">
        <GlassCard padding="lg">
          <p>For now, reach out directly to book your appointment.</p>
          <Button href="/contact" variant="primary">Contact Us</Button>
        </GlassCard>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stub-wrap {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .stub-wrap p {
    margin-bottom: var(--space-md);
  }
</style>