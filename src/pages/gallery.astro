---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Gallery from "../components/Gallery.astro";
import { collections } from "../data/collections";
import { getCollectionMedia } from "../utils/media";
---

<BaseLayout title="Gallery" description="Real client work from The Polished Co. Ke, organized by collection.">
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Our Work"
        title="Gallery"
        description="Real photos and videos from each collection, added directly by Jael as they're taken."
      />
      <div class="gallery-sections">
        {collections.map((collection) => {
          const media = getCollectionMedia(collection.slug);
          return (
            <div class="gallery-collection">
              <h3>{collection.name}</h3>
              <Gallery images={media.images} videos={media.videos} collectionName={collection.name} />
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .gallery-collection h3 {
    margin-bottom: var(--space-sm);
  }
</style>